# Production deployment.
#
# Defaults to **testnet** because that is the network the app is currently
# documented as running against. Confirm this against the intended release
# network before deploying; flipping networks is a one-line change here, and the
# build will refuse a mismatched RPC URL.

NEXT_PUBLIC_NETWORK=testnet

# Required.
NEXT_PUBLIC_CONTRACT_ID=C...replace-me...

# Required in practice: advertising a public origin is what marks the build as a
# deployment and enforces the contract requirement.
NEXT_PUBLIC_SITE_URL=https://synapse.example.com

# Optional overrides. Leave the RPC unset unless you need a private or
# third-party endpoint; when set, its host must match NEXT_PUBLIC_NETWORK.
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# VERCEL_URL is injected automatically on Vercel and can stand in for
# NEXT_PUBLIC_SITE_URL. Do not set it by hand.
# VERCEL_URL=

# ── Releasing against futurenet instead ───────────────────────────────────────
# NEXT_PUBLIC_NETWORK=futurenet
# NEXT_PUBLIC_CONTRACT_ID=C...
# NEXT_PUBLIC_SITE_URL=https://synapse.example.com
