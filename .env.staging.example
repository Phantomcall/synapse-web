# Staging / pre-production deployment.
#
# This is the case the issue is really about: a build that is reachable by
# others and must not be pointed at the wrong contract. Every value here is
# required, and `next build` fails if one is missing or inconsistent.
#
# Staging intentionally targets **futurenet**, so that staging exercises the
# non-default network path and a testnet misconfiguration is caught here rather
# than in production.

# Futurenet, so staging exercises the network that differs from the default.
NEXT_PUBLIC_NETWORK=futurenet

# Optional: omit to use the canonical futurenet endpoint. If set, the host must
# match the selected network, which catches a futurenet build reading testnet.
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org

# Required. A deployed build with no contract silently renders mock data, so
# this is enforced whenever a public origin is advertised.
NEXT_PUBLIC_CONTRACT_ID=C...replace-me...

# Required in practice: this advertises the origin, which is what marks the
# build as a deployment and triggers the contract requirement above.
NEXT_PUBLIC_SITE_URL=https://staging.synapse.example.com

# VERCEL_URL is injected automatically when deploying to Vercel and can stand in
# for NEXT_PUBLIC_SITE_URL. Do not set it by hand.
# VERCEL_URL=
